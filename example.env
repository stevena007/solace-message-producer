# Example Configuration File
# This file shows example configurations for different use cases

# Local Development (using Docker Solace broker)
HOST=tcp://localhost:55555
VPN=default
USERNAME=default
PASSWORD=

# Example Topic
TOPIC=test/messages

# Message Configuration
COUNT=100
SIZE=1024
RATE=10
TYPE=json

# Cloud Configuration Example (commented out)
# HOST=tcps://your-broker.messaging.solace.cloud:55443
# VPN=your-vpn-name
# USERNAME=your-username
# PASSWORD=your-password
# TOPIC=production/data
# COUNT=1000
# SIZE=2048
# RATE=50
# TYPE=json
